# ===========================================
# Production Environment
# ===========================================
# Rename this file to .env.production, then fill in your values.
#
# Vercel:      vercel env add       (or set them in the project dashboard)
# Cloudflare:  npm run cf:secrets   (pushes all values here to the Worker's secret store)
#
# NEXT_PUBLIC_* is inlined at build time. EMAIL_*, MAILGUN_* and
# CLOUDFLARE_TURNSTILE_SECRET_KEY are read at runtime from the platform's secret store —
# a committed file is NOT read at runtime.
# ===========================================

NEXT_PUBLIC_PRODUCTION_URL=https://yourdomain.com

# ---- Form email: fill in ONE of the two blocks below ----

# Cloudflare (Email Service, sent through the EMAIL binding in wrangler.jsonc).
# Used when EMAIL_DOMAIN is set. Mail is sent from contact@EMAIL_DOMAIN to
# EMAIL_TO, with a copy to EMAIL_DEV_TO. In development everything goes to
# EMAIL_DEV_TO only. Leave EMAIL_DOMAIN empty when deploying to Vercel.
EMAIL_DOMAIN=
EMAIL_FROM_NAME="Your Business"
EMAIL_TO=contact@yourdomain.com
EMAIL_DEV_TO=you@example.com
EMAIL_DEV_NAME="Your Name"

# Vercel (Mailgun). Used when EMAIL_DOMAIN is empty. Mail is sent from
# contact@MAILGUN_DOMAIN_NAME to MAILGUN_SMTP_MAIL, with a copy to
# MAILGUN_DEV_MAIL. In development everything goes to MAILGUN_DEV_MAIL only.
MAILGUN_DEV_MAIL=you@example.com
MAILGUN_DEV_NAME="Your Name"
# Blind copy of every form email (replaces the open copy to MAILGUN_DEV_MAIL)
MAILGUN_BCC_MAIL=""
MAILGUN_SMTP_MAIL=contact@yourdomain.com
MAILGUN_DOMAIN_NAME=mg.yourdomain.com
MAILGUN_FROM_NAME="Your Business"
MAILGUN_API_KEY=

# Cloudflare Turnstile (form spam protection, works on either host). Leave both
# empty to disable.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Analytics: nothing loads unless TRACK_ANALYTICS=true (keep false on test deploys).
NEXT_PUBLIC_GOOGLE_TAG_MANAGER=
NEXT_PUBLIC_HEAP_APP_ID=
NEXT_PUBLIC_STATCOUNTER_PROJECT=
NEXT_PUBLIC_STATCOUNTER_SECURITY=
NEXT_PUBLIC_GOOGLE_ANALYTICS=
NEXT_PUBLIC_GOOGLE_ADS_ID=
TRACK_ANALYTICS=false

# Free-estimate booking: your Calendly event link. Empty: the buttons go to /contact/.
NEXT_PUBLIC_CALENDLY_URL=
