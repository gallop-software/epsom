{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "epsom",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  // Serve only from the custom domain. Leaving workers.dev on would expose a
  // second public host with identical content.
  "workers_dev": false,
  // The epsom.gallop.software custom domain is attached to this
  // Worker at the account level (Workers > Domains), as on the other Gallop
  // templates. Your own site: add it under Settings > Domains & Routes, or list
  // it here as { "pattern": "yourdomain.com", "custom_domain": true } in "routes".
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "epsom",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
}
